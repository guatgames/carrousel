---
interface Props {
    total: number;
}

const { total } = Astro.props;
const pad = (value: number) => String(value).padStart(2, "0");
---

<div class="showcase-controls flex items-center justify-between gap-5 py-2 md:mt-6 md:bg-taupe-950/75 md:py-0">
    <div class="flex h-full w-full items-center justify-between p-2 md:p-6">
        <div class="flex items-center align-middle gap-3 md:gap-4">
            <div class="flex items-center gap-2 md:gap-3">
                <p class="font-display text-xl tracking-[0.1em] m-0 text-taupe-100/75 md:text-2xl md:m-2">
                    <span
                        data-mobile-current
                        data-showcase-current
                        aria-live="polite"
                    >
                        01
                    </span>
                    <span class="text-taupe-100/30"> / {pad(total)}</span>
                </p>
                <div
                    class="h-px w-14 overflow-hidden bg-taupe-100/15 md:w-40"
                    aria-hidden="true"
                >
                    <div
                        data-showcase-progress
                        class="h-full w-full origin-left scale-x-0 bg-reel-accent"
                    ></div>
                </div>
            </div>
            <button
                type="button"
                data-showcase-play
                aria-label="Pausar video"
                class="group flex items-center gap-2 text-taupe-100 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-reel-accent  md:flex-row md:gap-4 md:rounded-full md:border md:border-taupe-100/25 md:bg-taupe-100/10 md:px-8 md:py-3 md:backdrop-blur-md md:transition-colors md:duration-200 md:hover:bg-taupe-100/20 motion-reduce:md:transition-none cursor-pointer"
            >
                <span class="grid size-9 place-items-center rounded-full border border-taupe-100/45 bg-taupe-950/35 backdrop-blur-md transition-transform duration-300 ease-reveal group-hover:scale-105 md:size-6 md:border-0 md:bg-transparent md:backdrop-blur-none motion-reduce:transition-none motion-reduce:group-hover:scale-100">
                    <svg
                        data-showcase-play-icon
                        class="hidden size-4 text-gray-800 dark:text-white md:size-6"
                        aria-hidden="true"
                        xmlns="http://www.w3.org/2000/svg"
                        width="24"
                        height="24"
                        fill="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            fill-rule="evenodd"
                            d="M8 5v14l11-7z"
                            clip-rule="evenodd"
                        ></path>
                    </svg>
                    <svg
                        data-showcase-pause-icon
                        class="size-4 text-gray-800 dark:text-white md:size-6"
                        aria-hidden="true"
                        xmlns="http://www.w3.org/2000/svg"
                        width="24"
                        height="24"
                        fill="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            fill-rule="evenodd"
                            d="M8 5a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2H8Zm7 0a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-1Z"
                            clip-rule="evenodd"
                        ></path>
                    </svg>
                </span>
            </button>
        </div>

        <div class="flex items-center gap-3 md:gap-5">
            <div class="relative" data-showcase-volume-control>
                <button
                    type="button"
                    data-showcase-volume-toggle
                    aria-label="Controlar volumen"
                    aria-expanded="false"
                    aria-controls="showcase-volume-panel"
                    class="grid size-8 place-items-center rounded-full cursor-pointer bg-taupe-900/70 text-taupe-100/70 inset-ring-1 inset-ring-taupe-100/12 transition-[color,inset-ring-color,background-color] duration-200 hover:bg-taupe-900 hover:text-taupe-100 hover:inset-ring-taupe-100/25 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-reel-accent motion-reduce:transition-none md:size-10"
                >
                    <svg
                        data-showcase-volume-on
                        class="size-5"
                        aria-hidden="true"
                        xmlns="http://www.w3.org/2000/svg"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    >
                        <path d="M11 5 6 9H2v6h4l5 4V5Z"></path>
                        <path d="M15.5 8.5a5 5 0 0 1 0 7"></path>
                        <path d="M18.5 5.5a9 9 0 0 1 0 13"></path>
                    </svg>
                    <svg
                        data-showcase-volume-off
                        class="hidden size-5"
                        aria-hidden="true"
                        xmlns="http://www.w3.org/2000/svg"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    >
                        <path d="M11 5 6 9H2v6h4l5 4V5Z"></path>
                        <path d="m17 9 5 6m0-6-5 6"></path>
                    </svg>
                </button>

                <div
                    id="showcase-volume-panel"
                    data-showcase-volume-panel
                    data-open="false"
                    class="absolute bottom-full right-0 z-30 mb-3 w-48 translate-y-1 rounded-xl border border-taupe-100/10 bg-taupe-950/95 p-3 opacity-0 shadow-[0_20px_60px_-20px_#000000e6] backdrop-blur-xl transition-[opacity,transform] duration-200 ease-reveal pointer-events-none data-[open=true]:pointer-events-auto data-[open=true]:translate-y-0 data-[open=true]:opacity-100 motion-reduce:transition-none"
                >
                    <div class="flex items-center gap-2">
                        <button
                            type="button"
                            data-showcase-volume-mute
                            aria-label="Silenciar video"
                            class="grid size-7 shrink-0 place-items-center rounded-full cursor-pointer text-taupe-100/70 transition-colors duration-200 hover:bg-taupe-100/10 hover:text-taupe-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-reel-accent motion-reduce:transition-none"
                        >
                            <svg
                                data-showcase-volume-on
                                class="size-4"
                                aria-hidden="true"
                                xmlns="http://www.w3.org/2000/svg"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                            >
                                <path d="M11 5 6 9H2v6h4l5 4V5Z"></path>
                                <path d="M15.5 8.5a5 5 0 0 1 0 7"></path>
                                <path d="M18.5 5.5a9 9 0 0 1 0 13"></path>
                            </svg>
                            <svg
                                data-showcase-volume-off
                                class="hidden size-4"
                                aria-hidden="true"
                                xmlns="http://www.w3.org/2000/svg"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                            >
                                <path d="M11 5 6 9H2v6h4l5 4V5Z"></path>
                                <path d="m17 9 5 6m0-6-5 6"></path>
                            </svg>
                        </button>
                        <input
                            type="range"
                            min="0"
                            max="100"
                            step="1"
                            value="100"
                            data-showcase-volume
                            aria-label="Volumen del video"
                            class="volume-range min-w-0 flex-1"
                        />
                        <span
                            data-showcase-volume-value
                            class="w-8 shrink-0 text-right font-display text-sm text-taupe-100/70"
                        >
                            100
                        </span>
                    </div>
                </div>
            </div>

            <div class="hidden items-center gap-2 md:flex">
                <button
                    type="button"
                    data-showcase-prev
                    aria-label="Video anterior"
                    class="grid size-9 place-items-center rounded-full cursor-pointer bg-taupe-900/70 text-taupe-100/70 inset-ring-1 inset-ring-taupe-100/12 transition-[color,inset-ring-color,background-color] duration-200 hover:bg-taupe-900 hover:text-taupe-100 hover:inset-ring-taupe-100/25 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-reel-accent motion-reduce:transition-none md:size-10"
                >
                    <svg
                        class="w-6 h-6 text-gray-800 dark:text-white"
                        aria-hidden="true"
                        xmlns="http://www.w3.org/2000/svg"
                        width="24"
                        height="24"
                        fill="none"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke="currentColor"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="m15 19-7-7 7-7"
                        />
                    </svg>
                </button>
                <button
                    type="button"
                    data-showcase-next
                    aria-label="Video siguiente"
                    class="grid size-9 place-items-center rounded-full cursor-pointer bg-taupe-900/70 text-taupe-100/70 inset-ring-1 inset-ring-taupe-100/12 transition-[color,inset-ring-color,background-color] duration-200 hover:bg-taupe-900 hover:text-taupe-100 hover:inset-ring-taupe-100/25 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-reel-accent motion-reduce:transition-none md:size-10"
                >
                    <svg
                        class="w-6 h-6 text-gray-800 dark:text-white"
                        aria-hidden="true"
                        xmlns="http://www.w3.org/2000/svg"
                        width="24"
                        height="24"
                        fill="none"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke="currentColor"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="m9 5 7 7-7 7"
                        />
                    </svg>
                </button>
            </div>
            <h2 class="hidden font-display text-[clamp(1.5rem,3vw,2.75rem)] leading-none tracking-[0.14em] text-taupe-100/90 md:block">
                VIDEOS
            </h2>
        </div>
    </div>
</div>
