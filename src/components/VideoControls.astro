---
interface Props {
    total: number;
}

const { total } = Astro.props;
const pad = (value: number) => String(value).padStart(2, "0");
---

<div class="mt-4 flex items-end justify-between gap-5 md:mt-6">
    <div class="flex items-end gap-3 md:gap-4">
        <div class="flex items-center gap-2 md:gap-3">
            <p class="font-display text-2xl tracking-[0.1em] m-2 text-taupe-100/75">
            <span data-mobile-current data-showcase-current aria-live="polite">
                01
            </span>
            <span class="text-taupe-100/30"> / {pad(total)}</span>
        </p>
        <div
            class="h-px w-20 overflow-hidden bg-taupe-100/15 md:w-40"
            aria-hidden="true"
        >
           
        <div
                data-showcase-progress
                class="h-full w-full origin-left scale-x-0 bg-reel-accent"
            ></div>
            
        </div>
        </div>
        <button
            type="button"
            data-showcase-play
            aria-label="Pausar video"
            class="group mt-10 flex  items-center gap-2 text-taupe-100 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-reel-accent md:mt-14 md:flex-row md:gap-4 md:rounded-full md:border md:border-taupe-100/25 md:bg-taupe-100/10 md:px-8 md:py-3 md:backdrop-blur-md md:transition-colors md:duration-200 md:hover:bg-taupe-100/20 motion-reduce:md:transition-none cursor-pointer"
        >
            <span class="grid size-14 place-items-center rounded-full border border-taupe-100/45 bg-taupe-950/35 backdrop-blur-md transition-transform duration-300 ease-reveal group-hover:scale-105 md:size-6 md:border-0 md:bg-transparent md:backdrop-blur-none motion-reduce:transition-none motion-reduce:group-hover:scale-100">
                <svg
                    data-showcase-play-icon
                    class="hidden w-6 h-6 text-gray-800 dark:text-white"
                    aria-hidden="true"
                    xmlns="http://www.w3.org/2000/svg"
                    width="24"
                    height="24"
                    fill="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        fill-rule="evenodd"
                        d="M8 5v14l11-7z"
                        clip-rule="evenodd"
                    ></path>
                </svg>
                <svg
                    data-showcase-pause-icon
                    class="w-6 h-6 text-gray-800 dark:text-white"
                    aria-hidden="true"
                    xmlns="http://www.w3.org/2000/svg"
                    width="24"
                    height="24"
                    fill="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        fill-rule="evenodd"
                        d="M8 5a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2H8Zm7 0a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-1Z"
                        clip-rule="evenodd"
                    ></path>
                </svg>
            </span>
        </button>
    </div>

    <div class="flex items-center gap-3 md:gap-5">
        <div class="flex items-center gap-2">
            <button
                type="button"
                data-showcase-prev
                aria-label="Video anterior"
                class="grid size-9 place-items-center rounded-full cursor-pointer bg-taupe-900/70 text-taupe-100/70 inset-ring-1 inset-ring-taupe-100/12 transition-[color,inset-ring-color,background-color] duration-200 hover:bg-taupe-900 hover:text-taupe-100 hover:inset-ring-taupe-100/25 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-reel-accent motion-reduce:transition-none md:size-10"
            >
                <svg
                    class="w-6 h-6 text-gray-800 dark:text-white"
                    aria-hidden="true"
                    xmlns="http://www.w3.org/2000/svg"
                    width="24"
                    height="24"
                    fill="none"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke="currentColor"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="m15 19-7-7 7-7"
                    />
                </svg>
            </button>
            <button
                type="button"
                data-showcase-next
                aria-label="Video siguiente"
                class="grid size-9 place-items-center rounded-full cursor-pointer bg-taupe-900/70 text-taupe-100/70 inset-ring-1 inset-ring-taupe-100/12 transition-[color,inset-ring-color,background-color] duration-200 hover:bg-taupe-900 hover:text-taupe-100 hover:inset-ring-taupe-100/25 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-reel-accent motion-reduce:transition-none md:size-10"
            >
                <svg
                    class="w-6 h-6 text-gray-800 dark:text-white"
                    aria-hidden="true"
                    xmlns="http://www.w3.org/2000/svg"
                    width="24"
                    height="24"
                    fill="none"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke="currentColor"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="m9 5 7 7-7 7"
                    />
                </svg>
            </button>
        </div>
        <h2 class="font-display text-[clamp(1.5rem,3vw,2.75rem)] leading-none tracking-[0.14em] text-taupe-100/90">
            VIDEOS
        </h2>
    </div>
</div>
