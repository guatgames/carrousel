---
import type { ShowcaseItem } from "../types/VideoShowcase";

interface Props {
    item: ShowcaseItem;
}

const { item } = Astro.props;
---

<div class="absolute inset-0 -z-10 bg-taupe-950">
    <video
        data-showcase-video
        class="absolute inset-0 size-full bg-taupe-950 object-cover"
        poster={item.thumbnailSrc}
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        aria-hidden="true"
        tabindex="-1"
    ></video>
    <div class="absolute inset-0 bg-linear-to-b from-taupe-950/85 via-taupe-950/25 via-45% to-taupe-950/95"></div>
    <div class="absolute inset-0 [background:radial-gradient(ellipse_at_center,transparent_22%,#14110ecc_100%)]"></div>
</div>

<div class="relative flex flex-1 flex-col items-center justify-center px-5 pt-12 pb-[clamp(19rem,46vh,26rem)] text-center md:pb-[clamp(17rem,38vh,23rem)]">
    
    <h1
        data-showcase-title
        class="font-display text-[clamp(3.25rem,11vw,9rem)] leading-[0.92] tracking-[0.04em] uppercase text-taupe-100 [text-shadow:0_12px_48px_rgba(0,0,0,0.78)]"
    >
        {item.title}
    </h1>
    
</div>
