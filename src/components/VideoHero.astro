---
import type { ShowcaseItem } from "../types/VideoShowcase";

interface Props {
    item: ShowcaseItem;
}

const { item } = Astro.props;
---

<div
    class="relative aspect-[2/1] w-full shrink-0 bg-black shadow-[0_24px_60px_-36px_#000000e6] md:absolute md:inset-x-0 md:top-14 md:bottom-0 md:aspect-auto md:bg-taupe-950 md:shadow-none"
>
    <div class="absolute inset-0 overflow-hidden">
        <video
            data-showcase-video
            class="size-full bg-black object-contain md:object-cover"
            poster={item.thumbnailSrc}
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
            aria-hidden="true"
            tabindex="-1"
        ></video>
    </div>
</div>
