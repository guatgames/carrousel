---
import type { ShowcaseItem } from "../types/VideoShowcase";
import VideoHero from "./VideoHero.astro";
import VideoSelector from "./VideoSelector.astro";
import VideoControls from "./VideoControls.astro";

interface Props {
    items: ShowcaseItem[];
    label?: string;
}

const { items, label = "Galería cinematográfica" } = Astro.props;
---

<section
    data-video-showcase
    data-items={JSON.stringify(items)}
    aria-label={label}
    class="relative isolate grid h-dvh w-full grid-cols-[minmax(0,1fr)] grid-rows-[auto_auto_minmax(0,1fr)] overflow-hidden pt-14 text-taupe-100 md:block"
>
    <VideoHero item={items[0]} />

    <div class="relative z-20 border-b border-taupe-100/8 bg-taupe-950/95 md:absolute md:inset-x-0 md:bottom-0 md:z-20 md:border-0 md:bg-transparent">
        <div class="mx-auto w-full max-w-full">
            <VideoControls total={items.length} />
        </div>
    </div>

    <div class="relative z-10 min-h-0 md:absolute md:inset-x-0 md:bottom-[8.75rem] md:z-20">
        <div class="mx-auto h-full w-full max-w-full">
            <VideoSelector items={items} />
        </div>
    </div>
</section>

<script>
    import { initVideoShowcase } from "../js/videoShowcase.ts";

    document.querySelectorAll<HTMLElement>("[data-video-showcase]").forEach(initVideoShowcase);
</script>
