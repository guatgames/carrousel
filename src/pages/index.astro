---
import MainLayout from "../layout/MainLayout.astro";
import Carrousel from "../components/Carrousel.astro";
import { fetchMedia } from "../js/api.ts";
import type { Reel } from "../types/Reel.ts";

let reels: Reel[] = [];
let error: string | null = null;

try {
    reels = await fetchMedia();
} catch (cause) {
    error =
        cause instanceof Error ? cause.message : "Ocurrió un error inesperado.";
    console.error("[instagram] No se pudo cargar el feed:", cause);
}

const hasReels = reels.length > 0;
---

<MainLayout>
    <Carrousel items={reels} heading="h1" />
</MainLayout>
